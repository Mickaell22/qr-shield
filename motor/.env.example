# Configuracion del motor de deteccion
# Copiar este archivo a .env y completar segun entorno (dev/prod)

# === API keys (se usan desde Fase 2) ===
# Como obtener cada una:
#   - GOOGLE_SAFE_BROWSING_API_KEY: Google Cloud Console -> Safe Browsing API v4 (10k/dia free)
#   - URLHAUS_AUTH_KEY: urlhaus.abuse.ch/api/ -> registrarse en abuse.ch (gratis)
#                      Opcional: solo si se usa la API REST puntual.
#                      Los feeds CSV son libres y no la requieren (L3 sync los usa).
#   - VIRUSTOTAL_API_KEY: virustotal.com -> perfil -> API key (4 req/min, 500/dia free)
# GOOGLE_SAFE_BROWSING_API_KEY=
# URLHAUS_AUTH_KEY=
# VIRUSTOTAL_API_KEY=

# === Base de datos (se usa desde v0.2.0 - cache L2) ===
# DATABASE_URL=postgresql://umbral:umbral@localhost:5432/umbral

# === Nombre del producto ===
# Provisional: se lee desde una unica constante (app/config.py) para que un
# cambio de nombre no obligue a barrer el codigo.
# PRODUCT_NAME=Umbral

# === Trazabilidad de redirecciones (RF-009) ===
# Interruptor del modulo. Ponerlo en false SOLO para la corrida A/B del
# benchmark: la comparacion con y sin trazabilidad es la evidencia del aporte.
# REDIRECT_TRACING_ENABLED=true
# Tope de saltos de la cadena antes de reportarla como no resuelta.
# REDIRECT_MAX_HOPS=10
# Timeout de cada peticion, en segundos (SLA por capa: 1.5s).
# REDIRECT_TIMEOUT_SECONDS=1.5
# Presupuesto de la cadena completa, en segundos (SLA total: 3s).
# REDIRECT_TOTAL_TIMEOUT_SECONDS=2.0
