# Configuracion del motor de deteccion
# Copiar este archivo a .env y completar segun entorno (dev/prod)

# === API keys (se usan desde Fase 2) ===
# Como obtener cada una:
#   - GOOGLE_SAFE_BROWSING_API_KEY: Google Cloud Console -> Safe Browsing API v4 (10k/dia free)
#   - URLHAUS_AUTH_KEY: urlhaus.abuse.ch/api/ -> registrarse en abuse.ch (gratis)
#                      Opcional: solo si se usa la API REST puntual.
#                      Los feeds CSV hoy son libres; si se define, L3 la envia igual.
#   - VIRUSTOTAL_API_KEY: virustotal.com -> perfil -> API key (4 req/min, 500/dia free)
# GOOGLE_SAFE_BROWSING_API_KEY=
# URLHAUS_AUTH_KEY=
# VIRUSTOTAL_API_KEY=

# === Base de datos / cache de veredictos (L2) ===
# Sin DATABASE_URL la capa L2 queda desactivada y el motor analiza igual, solo
# sin cache. Completar con la cadena del entorno; no dejar credenciales aqui.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE
# Vigencia de un veredicto verde o amarillo, en segundos (por defecto 6h).
# CACHE_TTL_SECONDS=21600
# Vigencia de un veredicto rojo, en segundos (por defecto 24h): un dominio
# malicioso rara vez deja de serlo dentro del dia.
# CACHE_TTL_MALICIOUS_SECONDS=86400

# === Nombre del producto ===
# Provisional: se lee desde una unica constante (app/config.py) para que un
# cambio de nombre no obligue a barrer el codigo.
# PRODUCT_NAME=Umbral

# === Trazabilidad de redirecciones (RF-009) ===
# Interruptor del modulo. Ponerlo en false SOLO para la corrida A/B del
# benchmark: la comparacion con y sin trazabilidad es la evidencia del aporte.
# REDIRECT_TRACING_ENABLED=true
# Tope de saltos de la cadena antes de reportarla como no resuelta.
# REDIRECT_MAX_HOPS=10
# Timeout de cada peticion, en segundos (SLA por capa: 1.5s).
# REDIRECT_TIMEOUT_SECONDS=1.5
# Presupuesto de la cadena completa, en segundos (SLA total: 3s).
# REDIRECT_TOTAL_TIMEOUT_SECONDS=2.0

# === Metricas por capa (RF-008) ===
# Registrar la URL completa en el log de metricas. Por defecto false: el
# requisito pide registro anonimo, asi que en produccion se guarda solo un hash.
# Ponerlo en true SOLO para el benchmark, donde hace falta la URL para cruzar
# cada analisis con la etiqueta del dataset.
# METRICS_LOG_URLS=false

# === Feed local de URLhaus (L3) ===
# Volcado CSV de URLs maliciosas activas. Sin esta variable la capa L3 queda
# desactivada y el motor analiza igual. Valor de referencia (feed publico):
#   https://urlhaus.abuse.ch/downloads/csv_online/
# URLHAUS_FEED_URL=
# Cada cuanto se recarga el feed, en segundos (por defecto 12h).
# URLHAUS_REFRESH_SECONDS=43200
# Reintento tras una descarga fallida, en segundos. No bajar de 300: abuse.ch
# pide no descargar el volcado mas de una vez cada 5 minutos.
# URLHAUS_RETRY_SECONDS=300
# Timeout de la descarga, en segundos. Corre en segundo plano, fuera del SLA.
# URLHAUS_TIMEOUT_SECONDS=30
